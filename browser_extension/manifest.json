{
    "manifest_version": 3,
    "name": "Hornet Companion Bridge",
    "version": "0.5.0",
    "minimum_chrome_version": "121",
    "browser_specific_settings": {
        "gecko": {
            "id": "hornet-bridge@aicompanion.local",
            "strict_min_version": "128.0"
        }
    },
    "description": "Connects browser context to the local Hornet companion.",
    "permissions": [
        "tabs",
        "scripting",
        "webNavigation",
        "alarms"
    ],
    "host_permissions": [
        "<all_urls>",
        "http://127.0.0.1:8766/*"
    ],
    "background": {
        "service_worker": "background.js",
        "scripts": ["background.js"]
    },
    "content_scripts": [
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}
