# Copy to .env. Run the desktop app from the repository root.
# Change this to the directory Hornet may inspect with read-only project tools.
PROJECT_ROOT=.

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b
# Lower this (for example, to 8192) if GPU memory or response latency is a problem.
OLLAMA_NUM_CTX=24576

SEARXNG_URL=http://127.0.0.1:8888

TTS_PROFILE=gentle
TTS_VOICE=bf_emma
TTS_SPEED=0.90
# TTS_LANG=en-gb

CONVERSATION_RECENT_TURNS=30
CONVERSATION_TOKEN_BUDGET=9000
CONTEXT_REACTIONS_ENABLED=true
CONTEXT_REACTION_COOLDOWN=90

# Optional image generation: replace these with your own absolute paths.
# IMAGE_ENGINE_PYTHON=C:/path/to/AICompanion/image_engine/.venv/Scripts/python.exe
# FLUX_TRANSFORMER_PATH=C:/path/to/flux1-schnell-fp8-e4m3fn.safetensors
# FLUX_T5_PATH=C:/path/to/FLUX.1-schnell-text_encoder_2-FP8.pt
# IMAGE_OUTPUT_DIR=C:/path/to/AICompanion/generated/images
# IMAGE_GENERATION_TIMEOUT=900
# IMAGE_SEED=42
